  {
   "id": "not-just",
   "regex": "\\b(?:فقط|تنها)\\s+[^.!؟?\\n]{2,60}\\s+نیست[،,.]?\\s*بلکه\\b",
   "name": "«این فقط X نیست، بلکه Y»",
   "fix": "فقط حرفِ اصلی رو بزن. نیمه‌ی مقدمه رو حذف کن."
  },
  {
   "id": "not-only",
   "regex": "\\bنه\\s+(?:تنها|فقط)\\b[^.!؟?\\n]{2,80}\\bبلکه\\b",
   "name": "«نه تنها X، بلکه Y»",
   "fix": "دو جمله کن یا ضعیف‌تره رو بنداز."
  },
  {
   "id": "isnt-about",
   "regex": "\\b(?:این|موضوع)\\s+(?:درباره\\S*|مربوط به)\\s+[^.!؟?\\n]{2,60}\\s+نیست[.،!]\\s*(?:بلکه\\s+)?(?:درباره|مربوط)",
   "name": "«این درباره‌ی X نیست. درباره‌ی Y ـه.»",
   "fix": "یه بار بگو چی هست؛ «نیست»ِ ساختگی رو حذف کن."
  },
  {
   "id": "the-result",
   "regex": "(?m)^\\s*(?:نتیجه|جواب|حدس بزن|چرا|چطور|چی|پاسخ)\\s*[؟?]\\s*$",
   "name": "خطِ تک‌کلمه‌ای سوالی («نتیجه؟»)",
   "fix": "همون خط رو بذار توی جمله‌ی قبلی و جواب رو بده."
  },
  {
   "id": "heres-what",
   "regex": "\\bچیزی که یاد گرفتم\\b|\\bچیزهایی که یاد گرفتم\\b|\\bدرسی که گرفتم\\b|\\bاینه چیزی که یاد گرفتم\\b",
   "name": "«چیزی که یاد گرفتم این بود»",
   "fix": "خودِ درس رو بگو، نه اینکه اعلامش کنی."
  },
  {
   "id": "triad",
   "regex": "\\b\\w{3,}\\s*،\\s*\\w{3,}\\s+و\\s+\\w{3,}\\b",
   "name": "سه‌تاییِ «الف، ب و ج»",
   "fix": "یکی رو نگه دار؛ مخصوصاً اگه هر سه صفت باشن. (ممکنه غلطِ هشدار باشه.)"
  },
  {
   "id": "rocket",
   "regex": "[🚀🔥💡✨🎯💎🌟⚡]",
   "name": "ایموجیِ موشک/آتیش/لامپ/جرقه/هدف",
   "fix": "کپشن‌های ماشینی پر از اینن. اگه بذاری، یکی بذار."
  },
  {
   "id": "hashtag-wall",
   "regex": "(?:(?:^|\\s)#\\S+){6,}",
   "name": "دیوارِ هشتگ (۶ تا یا بیشتر)",
   "fix": "اینستاگرام از دی ۱۴۰۴ (دسامبر ۲۰۲۵) سقفِ ۵ هشتگ رو آورد؛ بیشتر از ۵ یعنی هدر. سه تا کافیه."
